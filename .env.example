# Memory Palace configuration. Copy to .env and edit, or export in your shell.
# Everything here is optional: with no configuration at all the system runs on
# the built-in mock providers and the repo-local Postgres cluster.

# --- database ---------------------------------------------------------------
# Defaults to the repo-local cluster started by `pnpm db:start`.
DATABASE_URL=postgresql://mp@127.0.0.1:55432/memory_palace

# --- who this instance belongs to -------------------------------------------
# Single-user: every row is namespaced by this id. Changing it gives you a
# completely separate memory store in the same database.
MP_USER_ID=default-user

# --- language model ---------------------------------------------------------
# mock         no API key, no network. A deterministic rule-based extractor.
#              Good enough to exercise everything; not good enough to trust.
# deepseek     cheap and strong at Chinese. Needs DEEPSEEK_API_KEY.
# openai       needs OPENAI_API_KEY.
# anthropic    needs ANTHROPIC_API_KEY.
MP_LLM_PROVIDER=mock

# Override the per-task models. Extraction runs on every note, so it is the
# high-volume path; adjudication runs once per candidate and benefits from a
# stronger model.
# MP_LLM_EXTRACTION_MODEL=deepseek-chat
# MP_LLM_ADJUDICATION_MODEL=deepseek-reasoner

DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# DeepSeek only enforces strict JSON schemas via tool calls on its /beta endpoint.
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- embeddings -------------------------------------------------------------
# The embedding model decides RECALL quality. It is a separate axis from the
# language model, which decides extraction and adjudication quality.
#
# mock    hashed bag-of-tokens. Captures lexical overlap only, NOT meaning, so
#         paraphrase recall will be poor. Fine for development; not for real use.
# ollama  local models through an Ollama server. Nothing leaves the machine.
#         bge-m3 (1024d) is the recommended default and matches the schema.
# openai  text-embedding-3-small; needs OPENAI_API_KEY.
#
# The schema stores a fixed-width vector because pgvector needs one to index.
# To use a model with a different width:
#   pnpm embedding:dim <N>      # alters the column, discards existing vectors
#   pnpm embedding:reembed      # recomputes them
MP_EMBEDDING_PROVIDER=mock
# MP_EMBEDDING_PROVIDER=ollama
# MP_EMBEDDING_MODEL=bge-m3
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# MP_EMBEDDING_PROVIDER=openai
# MP_EMBEDDING_MODEL=text-embedding-3-small
# MP_EMBEDDING_DIM=1536

# --- retrieval tuning -------------------------------------------------------
# Minimum cosine similarity for a semantic hit to count. This depends on the
# embedding model: a hashing stand-in scores unrelated text near 0, while bge-m3
# scores genuinely unrelated pairs at 0.50-0.55 — higher than the relevant
# paraphrase at 0.523. So this is not "the relevance test"; it is a noise filter
# whose only job now is to bound what an explicit `mode: "fast"` call may return
# (the smart path probes below it and vetoes on the model's verdict instead).
# Defaults are per provider and swept: mock 0.15, ollama 0.65.
# MP_RECALL_MIN_SEMANTIC_SIMILARITY=0.65

# Hard paraphrases ("怎么组织讲解？" vs a memory about explanation style) can land
# below the floor because they share little surface vocabulary with it. The smart
# recall path probes this far BELOW the floor and keeps a below-floor candidate
# only when the LLM reranker confirms it is actually relevant. The fast path never
# probes — without the reranker's confirmation a lowered floor only admits noise.
# 0 disables the probe.
# MP_RECALL_SEMANTIC_RESCUE_MARGIN=0.15
# Rerank relevance a below-floor candidate needs (0.6 = "useful background" in the
# rerank rubric). Lower is more permissive; rescued candidates have no above-floor
# evidence, so they are held to a stricter bar than ordinary hits.
# MP_RECALL_RESCUE_MIN_RELEVANCE=0.6

# On the smart path, a rerank relevance below this vetoes the candidate outright,
# whatever its blended score. Measured on bge-m3 + deepseek-reasoner: the model
# correctly scored two irrelevant pairs 0.050, but their blended score was still
# 0.56 — a lone semantic hit gets an RRF of 1.0, and that term alone outweighs a
# near-zero relevance. 0.3 is where the rerank rubric's own "not useful here"
# band ends. 0 disables the veto (the smart path then only *adds* candidates).
# Both this and the escalate threshold below default to 0 under
# MP_LLM_PROVIDER=mock, because the stand-in cannot judge relevance.
# MP_RECALL_MIN_RERANK_RELEVANCE=0.3

# `auto` (the default when an agent passes no mode) escalates to the smart path
# when the fast path's best answer rests on cosine alone and that cosine is below
# this. "Cosine alone" means no lexical or entity route matched it, so nothing
# corroborates it and only a reranker can settle it. Measured: escalating those
# answers took negative accuracy from 60% to 100% for 10 extra model calls over
# 14 queries, while the corroborated answers never left the fast path.
# MP_RECALL_ESCALATE_BELOW_SEMANTIC=0.6

# --- server -----------------------------------------------------------------
MP_API_HOST=127.0.0.1
MP_API_PORT=8787
MP_LOG_LEVEL=info

# Where the LLM response cache and eval output live.
MP_DATA_DIR=data
