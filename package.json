{
  "name": "memory-palace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal long-term memory infrastructure for AI agents",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "tsc --build",
    "build:clean": "tsc --build --clean",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx evals/run.ts",
    "eval:compare": "tsx evals/compare.ts",
    "db:init": "./scripts/db-local.sh init",
    "db:start": "./scripts/db-local.sh start",
    "db:stop": "./scripts/db-local.sh stop",
    "db:status": "./scripts/db-local.sh status",
    "db:psql": "./scripts/db-local.sh psql",
    "db:reset": "./scripts/db-local.sh reset",
    "migrate": "tsx packages/storage-pg/src/migrate-cli.ts",
    "dev:mcp": "tsx apps/mcp/src/main.ts",
    "dev:api": "tsx apps/api/src/main.ts",
    "setup": "pnpm install && pnpm db:init && pnpm db:start && pnpm migrate && pnpm build",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "demo": "tsx scripts/demo.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/backup.ts restore",
    "backup:check": "tsx scripts/backup.ts check",
    "embedding:dim": "tsx scripts/embedding.ts dim",
    "embedding:reembed": "tsx scripts/embedding.ts reembed",
    "embedding:status": "tsx scripts/embedding.ts status"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "26.6.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "@memory-palace/core": "workspace:*",
    "@memory-palace/runtime": "workspace:*",
    "@memory-palace/shared": "workspace:*",
    "@memory-palace/storage-pg": "workspace:*",
    "@memory-palace/llm": "workspace:*",
    "@memory-palace/test-support": "workspace:*",
    "@modelcontextprotocol/client": "2.0.0"
  }
}
